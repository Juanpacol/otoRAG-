      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/">
         <dc:format>application/pdf</dc:format>
         <dc:fileattributesize>35</dc:fileattributesize>
         <dc:subject>
            <rdf:Bag>
               <rdf:li>null</rdf:li>
               <rdf:li>American Academy of Otolaryngology</rdf:li>
               <rdf:li>benign paroxysmal positional vertigo</rdf:li>
               <rdf:li>evidence-based recommendation</rdf:li>
               <rdf:li>vestibular disorder</rdf:li>
               <rdf:li>Dix-Hallpike maneuver</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">The primary purposes of this guideline are to improve quality of care and outcomes for BPPV by improving the accurate and efficient diagnosis of BPPV, reducing the inappropriate&#xA;use of vestibular suppressant medications, decreasing the inappropriate use of ancillary tests such as radiographic imaging and vestibular testing, and to promote the use of effective repositioning maneuvers for treatment. In creating this guideline, the American Academy of Otolaryngologyâ€”Head and Neck Surgery Foundation selected a panel representing the fields of audiology, chiropractic medicine, emergency medicine, family medicine, geriatric medicine, internal medicine, neurology, nursing, otolaryngologyâ€“head and neck surgery, physical therapy, and physical medicine and rehabilitation.</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:modified>2012-11-15T19:18:16-06:00</dc:modified>
         <dc:creator>
            <rdf:Bag>
               <rdf:li>American Academy of Family Physicians</rdf:li>
            </rdf:Bag>
         </dc:creator>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Clinical practice guideline: Benign paroxysmal positional vertigo</rdf:li>
               <rdf:li xml:lang="x-repair">Clinical practice guideline: Benign paroxysmal positional vertigo</rdf:li>
            </rdf:Alt>
         </dc:title>
      </rdf:Description>
